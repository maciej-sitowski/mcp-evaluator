# Copy to `.env` (git-ignored); docker compose reads it automatically.

# Which agent / judge / models / products folder to use is set in the CONFIG section at the top of
# mcp-evaluator/run_evals.py. Here are only the secrets. (AGENT_PROVIDER=copilot docker compose run --rm mcp-evaluator
# overrides the choice for a single run.)

# Cursor: create a key at https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# GitHub Copilot: a fine-grained personal access token with the "Copilot Requests" permission
# (https://github.com/settings/personal-access-tokens), or any token of a user with a Copilot licence.
COPILOT_GITHUB_TOKEN=

# Optional: evaluate a real MCP server instead of the bundled mock.
# From inside Docker, a server on your own machine is http://host.docker.internal:<port>/mcp
# MCP_URL=https://your-mcp-host/mcp
# MCP_AUTH_HEADER=Bearer your-token      # sent as the Authorization header
